{
  "name": "compendium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compendium — offline-first unified Sorcery TCG companion (Codex · Decks · Play)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile:codex": "node scripts/compile-codex.mjs",
    "test:codex": "node --test \"scripts/codex/**/*.test.mjs\"",
    "test:query": "node --test \"src/store/**/*.test.mjs\"",
    "cap:sync": "cap sync",
    "android": "vite build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^5.0.1",
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "jeep-sqlite": "^2.7.5",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "1.11.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vite-plugin-static-copy": "^2.2.0"
  }
