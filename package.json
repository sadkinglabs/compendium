{
  "name": "compendium",
  "version": "1.0.3-alpha",
  "build": 237,
  "private": true,
  "type": "module",
  "description": "Compendium — offline-first Sorcery TCG companion (Home · Codex · Collection · Decks · Play)",
  "scripts": {
    "dev": "vite",
    "catalog:assert-clean": "node scripts/assert-no-pending-catalog-promote.mjs",
    "update:catalog": "node scripts/update-catalog.mjs",
    "prebuild": "npm run catalog:assert-clean",
    "build": "vite build",
    "preview": "vite preview",
    "precompile:codex": "npm run catalog:assert-clean",
    "compile:codex": "node scripts/compile-codex.mjs",
    "test:codex": "node --test \"scripts/codex/**/*.test.mjs\"",
    "test:query": "node --test \"src/store/**/*.test.mjs\"",
    "test:ui": "node --test \"src/pillars/**/*.test.mjs\" \"src/components/**/*.test.mjs\"",
    "test:app": "node --test \"src/*.test.mjs\"",
    "test:recog": "node --test \"scripts/recog/**/*.test.mjs\"",
    "recog:intake": "node scripts/recog/intake.mjs",
    "recog:score": "node scripts/recog/score.mjs",
    "check:types": "node --test scripts/check-types.test.mjs && node scripts/check-types.mjs",
    "check:cycles": "node --test scripts/check-cycles.test.mjs && node scripts/check-cycles.mjs",
    "check:source": "node --test scripts/check-source-guards.test.mjs && node scripts/check-source-guards.mjs",
    "check:smoke": "node --test scripts/check-smoke.test.mjs && node scripts/check-smoke.mjs",
    "test:catalog": "node --test \"scripts/catalog/**/*.test.mjs\"",
    "precheck:docs": "npm run catalog:assert-clean",
    "check:docs": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "cap:sync": "cap sync",
    "preandroid": "npm run catalog:assert-clean",
    "android": "vite build && cap sync android && node scripts/strip-native-wasm.mjs",
    "cap:open": "cap open android",
    "distribute": "node scripts/distribute.mjs",
    "fb:login": "firebase login"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "fflate": "^0.8.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.5",
    "aws4fetch": "^1.0.20",
    "firebase-tools": "^15.26.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "vite": "^8.2.1"
  }
}
