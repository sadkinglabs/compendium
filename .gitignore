node_modules/
dist/
.DS_Store
*.log
.vite/
.claude/worktrees/

# Capacitor native projects are tracked (Cap generates their own .gitignore for
# build artifacts). Remove the lines below if you'd rather regenerate them.
# android/
# ios/

# Named release APKs (compendium-<ver>.apk)
dist-apk/

# Firebase project config (client keys; keep out of history)
android/app/google-services.json

# Exported profile bundles and whole-app backups. These are REAL USER DATA - a profile
# export carries opponent names (a social graph of third parties), deck and card notes,
# and the whole collection ledger. They land in the repo root when a bundle is dragged
# off a device for a measurement or a repro, and must never reach history.
compendium-*.json
compendium-backup-*.json.gz

# Catalog drop folder: gigabytes of source PNGs/CSVs, never in history.
# Only the README (the drop how-to) is tracked.
CATALOG_DROP/*
!CATALOG_DROP/README.md

# Catalog pipeline staging + promotion journal (build-time scratch).
.catalog-build/

# Local secrets - R2 upload credentials, etc. NEVER commit. The .example template is tracked.
.env
.env.local
.env.r2
.env.discord
!.env.r2.example

# Distribution screenshots (generated, not tracked)
dist-shots/

# Android SIGNING SECRETS - never commit. build.gradle reads keystore.properties
# for the release keystore path + passwords; leaking it lets anyone sign as this app.
android/keystore.properties
keystore.properties
*.jks
*.keystore

# Machine-specific - a collaborator generates their own (SDK path, IDE metadata).
local.properties
android/local.properties
.idea/
*.iml
.gradle/

# Transient review scaffolds
CODEX-*.md
docs/proposals/*.diff

# Card-recogniser governed image store - private tester/eval photos NEVER enter git.
# The committed authority is data/recog/manifest.json (metadata only, no image bytes, no PII).
recog-data/
scripts/recog/train/.venv/
scripts/recog/train/_out/
scripts/recog/train/__pycache__/
scripts/recog/train/*.pt

# Card-recogniser bundled assets - generated by scripts/recog/train/{build_artifact,build_index}.py, not committed as blobs
android/app/src/main/assets/recog/
