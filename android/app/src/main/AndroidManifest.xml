<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- PORTRAIT ON PHONES, FREE ROTATION ON TABLETS - and the way to get that is to declare
             NOTHING here, which is why this comment exists in place of a property.

             From Android 16, a display whose smallest width is >= 600dp (tablets, unfolded
             foldables, desktop windowing) IGNORES android:screenOrientation,
             android:resizeableActivity, min/maxAspectRatio and setRequestedOrientation().
             Phones (< 600dp) are exempt from that override entirely.

             So the platform default already splits exactly where we want it: the activities below
             keep android:screenOrientation="portrait", phones honour it, and large screens do not.

             android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY was declared here briefly
             and REMOVED on owner decision (2026-08-12) after seeing it on hardware. It forces
             portrait on large screens too, and the result is a letterboxed phone-shaped app on a
             tablet - which is worse than either alternative. Measured on a Lenovo TB321FU
             (Android 16, 640dp): with the property the display was pinned to ROTATION_0 and the
             app rendered 1600x2560; without it the tablet rotates and the app renders 2560x1600
             full screen.

             Do not re-add it to "fix" tablet rotation. Rotation on a tablet is the intent. -->


        <!-- ============================ TELEMETRY ============================
             Both SDKs collect NOTHING until the user answers the disclosure.
             These four flags are what make that true, and it is measured, not
             assumed: a virgin install with them set transmits 0 bytes over 3
             minutes, where build 37 transmitted 13,666. Firebase still starts -
             initialization is not transmission.

             READ THIS BEFORE CHANGING ANY OF THEM: these are the INITIAL DEFAULT,
             not a standing floor. Once TelemetryPlugin calls setXCollectionEnabled,
             that runtime override persists and beats the manifest forever after.
             Boot reconciliation, not these flags, is what keeps a denied user off.
             See docs/proposals/telemetry-consent.md. -->
        <meta-data android:name="firebase_analytics_collection_enabled"   android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />

        <!-- No advertising identifier, ever. This stops the SDK READING one; the
             tools:node="remove" entries below stop the manifest DECLARING one.
             Both are required - the flags alone remove no permission (measured:
             a flags-only build still declared all 12, AD_ID included). -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals"
                   android:value="false" />
        <!-- ================================================================== -->
        <!-- configChanges carries navigation (added by the Capacitor 7 checklist) and density
             (Capacitor 8). Both mean "handle this configuration change in-place rather than be
             recreated", which for a WebView activity avoids tearing down and rebuilding the
             whole web app over a change it does not care about. Left off ScannerActivity
             deliberately: recreating a camera screen is cheap and safe, and the checklist
             governs the Capacitor activity, not ours.

             screenOrientation is portrait by product decision: the app has no landscape layouts
             and needs none. It was NOT previously declared here - only ScannerActivity was
             locked - so the main app rotated. The application-level opt-out above is what keeps
             this honoured on >= 600dp displays at target 36; phones honour it regardless. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for peer-to-peer match sharing: an opponent's camera
                 opens compendium://match?d=... straight into the import screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="compendium" android:host="match" />
                <data android:scheme="compendium" android:host="deck" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Offline card scanner (native Compose + CameraX + BUNDLED ML Kit). No
             com.google.mlkit.vision.DEPENDENCIES meta-data - that would trigger the
             unbundled runtime model download and break offline. -->
        <activity
            android:name=".scanner.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.Compendium.Scanner" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Merged in by play-services-measurement* (= firebase-analytics), which the
         manifest merger adds silently. Build 37 shipped an app that asked for a
         cross-app ADVERTISING ID; nobody decided that, it arrived with a BoM.

         FOUR entries, not one, because they come from THREE different artifacts:
         removing AD_ID alone leaves ACCESS_ADSERVICES_AD_ID, the Privacy Sandbox
         path to the same identifier - the half-fix that looks complete.
             AD_ID                        <- play-services-measurement-impl
             ACCESS_ADSERVICES_AD_ID      <- play-services-measurement-api
             ACCESS_ADSERVICES_ATTRIBUTION<- play-services-measurement-api
             BIND_GET_INSTALL_REFERRER_*  <- play-services-measurement  (unused install attribution)

         ACCESS_NETWORK_STATE and WAKE_LOCK come from the same tree and are KEPT:
         Analytics needs them to batch uploads. Removing them to shorten the list
         would break the thing this is preserving.

         The `checkForbiddenPermissions` Gradle task fails assembleRelease if any
         of these reappear. Verify with the RELEASE ARTIFACT, never the source
         manifest - reading the wrong one is why this went unnoticed for 37 builds. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
                     tools:node="remove" />

    <!-- Merged in by androidx.biometric, which @capacitor-community/sqlite declares
         (node_modules/@capacitor-community/sqlite/android/build.gradle) for biometric
         unlock of an ENCRYPTED database. Compendium has no encrypted database:
         capacitor.config.json sets "androidIsEncryption": false, and db.js opens every
         connection with 'no-encryption'. In the plugin's CapacitorSQLite constructor the
         biometric block is nested inside `if (isEncryption)`, so the code is unreachable
         and these two permissions are asking for a sensitive capability the app cannot
         use. Play flags exactly that.

         USE_FINGERPRINT is additionally deprecated (API 28 superseded it with
         USE_BIOMETRIC), so this removes a deprecated permission AND an unused one.

         The permissions go, the library stays: the plugin's own Java imports
         BiometricPrompt (UtilsBiometric.java, BiometricListener.java), so excluding
         androidx.biometric would stop it compiling. Dead classes are cheap; a sensitive
         permission on the store listing is not. If encryption is ever switched on, these
         two removes must come out and the gate below must be updated in the same change. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
</manifest>
