# Cloudflare R2 - card-art delivery. Copy this file to `.env.r2` and fill in the blanks.
# `.env.r2` is gitignored; NEVER commit real keys.

# PUBLIC read URL - the app loads art from here. PRODUCTION is the edge-cached custom domain
# (an R2 Custom Domain on the same account). The r2.dev dev URL is an interim/fallback only. No
# trailing slash.
R2_PUBLIC_BASE_URL=https://cdn.sadkinglabs.com

# S3-compatible UPLOAD endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# R2 API token (permission: Object Read & Write), shown once on creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name.
R2_BUCKET=compendium-art
