# Cloudflare R2 - card-art delivery. Copy this file to `.env.r2` and fill in the blanks.
# `.env.r2` is gitignored; NEVER commit real keys.

# PUBLIC read URL - the app loads art from here. Start with the r2.dev dev URL; swap for
# cdn.<yourdomain> later (one-line change). No trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# S3-compatible UPLOAD endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# R2 API token (permission: Object Read & Write), shown once on creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name.
R2_BUCKET=compendium-art
